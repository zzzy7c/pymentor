# 沙箱镜像 —— **隔离用户代码的唯一安全边界**（AGENTS.md §4：改动需人工 review）。
#
# 构建：
#   docker build -f src/pyassist/sandbox/Dockerfile.sandbox -t pyassist-sandbox:1 .
#
# 运行期由 sandbox/runner.py 注入 /work/main.py；镜像里**不打包任何用户代码**。
# 真正的隔离来自 runner 的 containers.create 参数（network_disabled / read_only /
# cap_drop / pids_limit / user ...），镜像只负责"用户是 10001、工作目录存在"。
FROM python:3.12-slim

RUN groupadd --gid 10001 sandbox \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sandbox \
 && mkdir -p /work /tmp \
 && chown -R 10001:10001 /work /tmp

WORKDIR /work
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp TMPDIR=/tmp

CMD ["python", "-I", "-u", "/work/main.py"]
