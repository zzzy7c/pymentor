# 变量清单（不含真实值）。复制为 .env 后填入真实值：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥（§4）。

# --- LLM 供应商（唯一：DeepSeek）---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# --- 数据库（开发用 SQLite；生产换 PostgreSQL 连接串）---
# 开发必须用异步驱动 sqlite+aiosqlite（SPEC §4.1）；留空则用 config.py 的绝对路径默认值。
DATABASE_URL=sqlite+aiosqlite:///data/app.db

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- 向量化模型（阶段五选型，非 DeepSeek 提供，§1）---
# 留空则用 config.DEFAULT_EMBEDDING_MODEL_ID（BAAI/bge-m3）；换模型须删 data/chroma 重跑 ingest
EMBEDDING_MODEL_ID=

# --- 单日 Token 熔断（留空 = 用 config.DEFAULT_DAILY_TOKEN_LIMIT；0 = 关闭，仅本地调试）---
DAILY_TOKEN_LIMIT=

# --- 前端调用后端的地址（web 容器里是 http://api:8000）---
PYASSIST_API_BASE_URL=http://127.0.0.1:8000
