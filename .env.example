# 变量清单（不含真实值）。复制为 .env 后填入真实值：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥（§4）。

# --- LLM 供应商（唯一：DeepSeek）---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# --- 数据库（开发用 SQLite；生产换 PostgreSQL 连接串）---
DATABASE_URL=sqlite+pysqlite:///data/app.db

# --- 日志 ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- 向量化模型（阶段五选型，非 DeepSeek 提供）---
EMBEDDING_MODEL_ID=

# --- 单日 Token 熔断阈值（留空 = 不熔断，见 ROADMAP 待定项 5）---
DAILY_TOKEN_LIMIT=
